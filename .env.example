VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PAYMENT_PROVIDER=mock
UNPAID_ORDER_TIMEOUT_MINUTES=10
NO_SHOW_AFTER_MINUTES=30
SENTRY_DSN=
