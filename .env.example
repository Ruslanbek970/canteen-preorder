APP_ENV=dev
TZ=Asia/Almaty
DATABASE_URL=postgresql+psycopg://canteen:canteen@db:5432/canteen
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_EMAIL_DOMAINS=demo.kz,uni.kz
FRONTEND_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
