# Production settings: copy to .env on the server (docs/deployment.md). Never commit .env.
# In GitHub this whole file goes into the PROD_ENV secret; the deploy writes it to the server.

# --- server and images ---
DOMAIN=canteen.example.kz
ACME_EMAIL=admin@example.kz
GHCR_OWNER=ruslanbek970
GRAFANA_ADMIN_PASSWORD=change-me

# --- database (the same password in both lines) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://canteen:change-me@db:5432/canteen
# gunicorn processes; WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) < 100 with room left
WEB_CONCURRENCY=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# --- app ---
TZ=Asia/Almaty
# openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_EMAIL_DOMAINS=uni.kz
FRONTEND_URL=https://canteen.example.kz
PAYMENT_PROVIDER=mock
UNPAID_ORDER_TIMEOUT_MINUTES=10
NO_SHOW_AFTER_MINUTES=30
SEMESTER_START=2026-09-01
HOLIDAYS=

# --- e-mail (codes for registration) ---
SMTP_HOST=smtp.example.kz
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.kz

# --- notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# A chat for monitoring alerts (Alertmanager); empty = alerts only in Grafana
ALERT_TELEGRAM_CHAT_ID=
# docker compose -f docker-compose.prod.yml run --rm backend python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.kz
SENTRY_DSN=
